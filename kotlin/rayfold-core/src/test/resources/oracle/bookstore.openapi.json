{
 "openapi": "3.2.0",
 "info": {
  "title": "Rayfold API",
  "version": "0.1"
 },
 "paths": {
  "/books": {
   "query": {
    "operationId": "books",
    "parameters": [],
    "summary": "List books, newest first.",
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "filter": {
          "anyOf": [
           {
            "$ref": "#/components/schemas/BookFilter"
           },
           {
            "type": "null"
           }
          ]
         },
         "page": {
          "$ref": "#/components/schemas/PageArgs"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Result in the requested shape (default view when no shape is given)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Page_Book"
        }
       }
      }
     },
     "304": {
      "description": "Not modified (ETag revalidation)"
     },
     "400": {
      "description": "Invalid argument, including schema constraints such as @range",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "401": {
      "description": "Sign-in required by a policy",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "403": {
      "description": "Denied by a policy",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     }
    }
   }
  },
