  "/orders": {
   "post": {
    "operationId": "placeOrder",
    "parameters": [
     {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "description": "Replays the original response on retry",
      "schema": {
       "type": "string",
       "minLength": 16,
       "maxLength": 128
      }
     }
    ],
    "summary": "Place an order. Fails atomically if any line is out of stock.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/OrderInput"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Result in the requested shape (default view when no shape is given)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Order"
        }
       }
      }
     },
     "400": {
      "description": "Invalid argument, including schema constraints such as @range",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "401": {
      "description": "Sign-in required by a policy",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "403": {
      "description": "Denied by a policy",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     },
     "422": {
      "description": "Declared domain errors: OutOfStock, PaymentDeclined",
      "content": {
       "application/problem+json": {
        "schema": {
         "oneOf": [
          {
           "allOf": [
            {
             "$ref": "#/components/schemas/Problem"
            },
            {
             "properties": {
              "title": {
               "const": "OutOfStock"
              },
              "data": {
               "$ref": "#/components/schemas/OutOfStock"
              }
             }
            }
           ]
          },
          {
           "allOf": [
            {
             "$ref": "#/components/schemas/Problem"
            },
            {
             "properties": {
              "title": {
               "const": "PaymentDeclined"
              },
              "data": {
               "$ref": "#/components/schemas/PaymentDeclined"
              }
             }
            }
           ]
          }
         ]
        }
       }
      }
     }
    }
   }
  },
