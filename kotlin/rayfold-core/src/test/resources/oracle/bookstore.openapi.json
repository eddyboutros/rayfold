      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "If-Match",
      "in": "header",
      "required": false,
      "description": "Entity version from a previous response; 412 with the current entity when stale",
      "schema": {
       "type": "string"
      }
     }
    ],
    "summary": "Replace a review's rating and text. Only its author (or an admin) may edit it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ReviewEdit"
