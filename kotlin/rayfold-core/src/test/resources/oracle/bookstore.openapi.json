      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/BookPatch"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Result in the requested shape (default view when no shape is given)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Book"
        }
       }
      }
     },
     "400": {
      "description": "Invalid argument, including schema constraints such as @range",
      "content": {
       "application/problem+json": {
