            },
            {
              "$type": "Photo",
              "url": "https://img.example/1.png"
            }
          ],
          "meta": {
            "cost": 1
          },
          "fin": true
        }
      ]
    },
    {
      "name": "@defer at a union position delivers its part for each member",
      "request": {
        "ops": [
          {
            "id": 1,
            "op": "pubs",
            "shape": "{ ...on Book { id } ...on Author { id } @defer { ...on Book { pages } ...on Author { name } } }"
