  "cases": [
    {
      "name": "...on an interface selects its fields on the union members that implement it",
      "request": {
        "ops": [
          {
            "id": 1,
            "op": "search",
            "shape": "{ ...on Named { name } ...on Photo { url } }"
          }
        ]
      },
