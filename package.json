{
  "name": "rayfold-monorepo",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddyboutros/rayfold.git"
  },
  "homepage": "https://github.com/eddyboutros/rayfold#readme",
  "bugs": {
    "url": "https://github.com/eddyboutros/rayfold/issues"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "conformance"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "conform": "vitest run --project conformance",
    "rayfold": "tsx packages/cli/src/main.ts",
    "bench": "tsx bench/run.ts",
    "bench:load": "tsx bench/load.ts",
    "e2e": "vitest run e2e",
    "e2e:html": "tsx e2e/report-html.ts",
    "test:browsers": "playwright test",
    "check:proxy": "node scripts/proxy-check.mjs",
    "demo": "tsx examples/bookstore-web/server.ts",
    "import:gutenberg": "tsx scripts/import-gutenberg.ts",
    "build": "node scripts/build.mjs",
    "smoke:packages": "node scripts/smoke-packages.mjs",
    "release:dry-run": "node scripts/publish.mjs --dry-run",
    "release": "node scripts/publish.mjs",
    "docs:site": "node scripts/build-site.mjs",
    "sync:explorer": "node scripts/sync-explorer.mjs",
    "smoke:maven": "node scripts/smoke-maven.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "graphql": "^16.14.2"
  }
}
