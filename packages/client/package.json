{
  "name": "@rayfold/client",
  "version": "0.2.0",
  "private": true,
  "description": "Rayfold client for browsers and Node.js: a normalized cache kept current by server patches, batching and live queries.",
  "keywords": [
    "rayfold",
    "api",
    "protocol",
    "client",
    "cache",
    "fetch",
    "websocket",
    "live-queries"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@rayfold/schema": "*",
    "@rayfold/rb": "*",
    "@rayfold/server": "*"
  }
}
