{
  "name": "@rayfold/otel",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTelemetry tracing for Rayfold servers: a span per batch, per op and per loader call, continuing the caller's W3C trace.",
  "keywords": [
    "rayfold",
    "api",
    "protocol",
    "opentelemetry",
    "tracing",
    "observability"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@rayfold/server": "*"
  }
}
