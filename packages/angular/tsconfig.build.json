{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": [],
    "paths": {
      "@rayfold/client": ["../client/dist/index.d.ts"],
      "@rayfold/schema": ["../schema/dist/index.d.ts"],
      "@rayfold/rb": ["../rb/dist/index.d.ts"],
      "@rayfold/server/protocol": ["../server/dist/protocol.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
