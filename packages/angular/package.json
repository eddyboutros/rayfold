{
  "name": "@rayfold/angular",
  "version": "0.2.0",
  "private": true,
  "description": "Angular bindings for Rayfold: injectQuery, injectLive and injectCommand as signals, on top of @rayfold/client's self-updating cache.",
  "keywords": [
    "rayfold",
    "api",
    "protocol",
    "angular",
    "signals",
    "cache",
    "live-queries"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "@rayfold/client": "*"
  }
}
